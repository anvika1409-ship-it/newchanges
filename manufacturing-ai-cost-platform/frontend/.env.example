# ---------------------------------------------------------------------------
# Frontend environment.
#
# Anything prefixed VITE_ is embedded into the JavaScript bundle and is public.
# NEVER put an API key, token or any other secret in this file
# (AI_DEVELOPMENT_RULES.md section 19, SECURITY.md section 6).
# ---------------------------------------------------------------------------

# Base path for API calls. Left as a relative path so the dev-server proxy and
# a production reverse proxy both work without rebuilding.
VITE_API_BASE_URL=/api/v1

# Target the dev server proxies /api to.
VITE_DEV_API_TARGET=http://localhost:8000
