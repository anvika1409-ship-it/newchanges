# ---------------------------------------------------------------------------
# Secrets — never commit real credentials (SECURITY.md section 6)
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials.json

# ---------------------------------------------------------------------------
# SQLite database files (DATABASE_SCHEMA.md section 22, SECURITY.md section 21)
# The database file must never be committed or served from a public directory.
# ---------------------------------------------------------------------------
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backend/data/
!backend/data/.gitkeep

