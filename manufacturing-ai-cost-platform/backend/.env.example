# ---------------------------------------------------------------------------
# Example environment file.
#
# Copy to `.env` and fill in real values locally:
#     cp .env.example .env
#
# `.env` is gitignored. NEVER commit real credentials (SECURITY.md section 6,
# AI_DEVELOPMENT_RULES.md section 5). Every value below is a placeholder.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME=manufacturing-ai-cost-platform
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Logging (AI_DEVELOPMENT_RULES.md section 27) ---------------------------
# LOG_FORMAT: json | console
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Database --------------------------------------------------------------
# SQLite is the MVP database (DATABASE_SCHEMA.md section 1).
# Business logic must stay behind SQLAlchemy repositories so this URL can later
# point at PostgreSQL without touching business code.
DATABASE_URL=sqlite+aiosqlite:///./data/platform.db
DATABASE_ECHO=false
SQLITE_BUSY_TIMEOUT_MS=5000

# --- Redis -----------------------------------------------------------------
# Listed as a core component in ARCHITECTURE.md section 13. Its platform role is
# still an open item in that document; this scaffold treats it only as a
# connection-checked dependency and implements no caching semantics.
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true

# --- Model gateway ---------------------------------------------------------
# MODEL_GATEWAY_PROVIDER: genailab | mock
# Tests and local development default to `mock` so no live LLM call is made
# (AI_DEVELOPMENT_RULES.md section 25).
MODEL_GATEWAY_PROVIDER=mock

# --- GenAILab (ARCHITECTURE.md section 7) ----------------------------------
# Only used when MODEL_GATEWAY_PROVIDER=genailab.
# GENAI_API_KEY is a secret: environment only, never hard-coded, never logged,
# never sent to the frontend, never placed in a prompt.
GENAI_BASE_URL=https://genailab.tcs.in/v1
GENAI_API_KEY=replace-me-do-not-commit
GENAI_TIMEOUT_SECONDS=60

# Resilience (SECURITY.md section 19). GENAI_MAX_ATTEMPTS counts the first try,
# so 1 disables retrying. Only retryable failures (timeout, 429, 5xx,
# connection) are retried; an auth or bad-request failure never is.
GENAI_MAX_ATTEMPTS=3
GENAI_RETRY_BASE_DELAY_SECONDS=0.5
GENAI_RETRY_MAX_DELAY_SECONDS=8
GENAI_RETRY_MAX_ELAPSED_SECONDS=60

GENAI_CIRCUIT_BREAKER_ENABLED=true
GENAI_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
GENAI_CIRCUIT_BREAKER_RESET_SECONDS=30

# Live smoke test against GenAILab. Off by default: enabling it makes real,
# billable calls. Set the model id from the model registry.
GENAI_SMOKE_TEST_ENABLED=false
GENAI_SMOKE_TEST_MODEL=

# TLS verification.
# `false` is permitted for the current internal development environment.
# For production prefer `true` with the approved internal CA. Setting
# SSL_VERIFY=false while APP_ENV=production is rejected at startup unless
# ALLOW_INSECURE_TLS=true is set as a documented, deliberate exception.
SSL_VERIFY=false
ALLOW_INSECURE_TLS=false

# --- Authentication (SECURITY.md section 3) --------------------------------
# AUTH_MODE: development | oidc
# `development` signs and verifies tokens with a local symmetric key. It is
# refused when APP_ENV=production.
# `oidc` is the enterprise seam and is not implemented; selecting it fails fast.
AUTH_MODE=development

# JWT validation. Signature, expiry, not-before, issuer and audience are all
# verified in both modes; only the key source differs.
# JWT_SECRET is a secret: environment only, never committed, never logged.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_ALGORITHM=HS256
JWT_SECRET=replace-me-with-a-random-value-of-at-least-32-bytes
JWT_ISSUER=manufacturing-ai-cost-platform
JWT_AUDIENCE=manufacturing-ai-cost-platform-api
JWT_LEEWAY_SECONDS=0
JWT_ACCESS_TOKEN_TTL_SECONDS=900

# Claim mapping. Tenant and role claims are not standardised by OIDC, so the
# names your provider uses are configuration rather than an assumption.
JWT_TENANT_CLAIM=tenant_id
JWT_ROLES_CLAIM=roles

# OIDC seam. Fill these in when implementing OidcIdentityAdapter.
OIDC_ISSUER=
OIDC_JWKS_URL=
OIDC_AUDIENCE=

# --- API security (SECURITY.md section 18) ---------------------------------
CORS_ALLOW_ORIGINS=http://localhost:5173
MAX_REQUEST_BYTES=10485760
